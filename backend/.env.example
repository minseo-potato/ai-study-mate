# 이 파일을 .env로 복사해서 값을 채우세요. .env는 Git에 올라가지 않아요.

# OpenAI API 키. 넣으면 AI 친구들이 실제 AI로 대답하고, 비워 두면 미리 정해 둔 응답으로 동작해요.
OPENAI_API_KEY=

# 사용할 모델 (비워 두면 gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# 생각을 얼마나 깊게 할지: none, low, medium, high, xhigh, max (비워 두면 medium)
# 높을수록 답이 신중해지지만 느려지고 비용이 늘어요.
# OPENAI_REASONING_EFFORT=

# 키가 있어도 미리 정해 둔 응답으로 쓰고 싶으면 1, 키가 있을 때 실제 AI를 강제로 쓰려면 0
# DEMO_MODE=

# 데이터베이스 파일 위치 (비워 두면 서버를 실행한 폴더의 study_mate.sqlite3)
# DATABASE_PATH=study_mate.sqlite3

# 여러 사람에게 공개할 때: 앱 주소(쉼표로 구분)만 허용하고 API 문서를 끄세요. HTTPS 뒤에서 실행해야 해요.
# ALLOWED_ORIGINS=https://example.com
# DOCS=0
